<Window x:Class="WpfMarkdownViewer.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WpfMarkdownViewer.Controls;assembly=WpfMarkdownViewer"
        Title="WpfMarkdownViewer 演示" Height="760" Width="900" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FFF7F7F9" BorderBrush="#FFE3E3E8" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button x:Name="ReplayButton" Content="重新播放流式" Click="OnReplay" Padding="12,5"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#FF6B7280"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ctrl:MarkdownDocumentView x:Name="Viewer" Background="White"/>
        </ScrollViewer>
    </DockPanel>
</Window>
