<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The demo wants every capability, so it references the meta-package and calls DefaultCapabilities.RegisterAll(). -->
    <ProjectReference Include="..\..\src\WpfMarkdownViewer.All\WpfMarkdownViewer.All.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
